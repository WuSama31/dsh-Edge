{
  "name": "@local/dsh-edge-browser",
  "version": "0.1.0",
  "description": "DeepSeek Harness plugin that reads and operates web pages in Microsoft Edge over the Chrome DevTools Protocol.",
  "type": "module",
  "main": "./index.js",
  "exports": {
    ".": "./index.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "lib",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "edge",
    "browser",
    "cdp",
    "devtools-protocol",
    "automation"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/WuSama31/dsh-edge-browser.git"
  },
  "homepage": "https://github.com/WuSama31/dsh-edge-browser#readme",
  "bugs": {
    "url": "https://github.com/WuSama31/dsh-edge-browser/issues"
  },
  "author": "WuSama31",
  "license": "MIT",
  "engines": {
    "node": ">=20"
  }
}
